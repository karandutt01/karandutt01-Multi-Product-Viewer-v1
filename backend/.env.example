# Google Service Account Configuration
GOOGLE_SERVICE_ACCOUNT_TYPE=service_account
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=<YOUR_PROJECT_ID>
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=<PRIVATE_KEY_ID_PLACEHOLDER>
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="<PRIVATE_KEY_PLACEHOLDER>"
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=<SERVICE_ACCOUNT_EMAIL>
GOOGLE_SERVICE_ACCOUNT_CLIENT_ID=<CLIENT_ID_PLACEHOLDER>
GOOGLE_SERVICE_ACCOUNT_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SERVICE_ACCOUNT_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SERVICE_ACCOUNT_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SERVICE_ACCOUNT_CLIENT_CERT_URL=<CLIENT_CERT_URL_PLACEHOLDER>
GOOGLE_UNIVERSE_DOMAIN=googleapis.com

# Firebase Configuration Template
FIREBASE_API_KEY=<FIREBASE_API_KEY>
FIREBASE_AUTH_DOMAIN=<YOUR_PROJECT_ID>.firebaseapp.com
FIREBASE_PROJECT_ID=<YOUR_PROJECT_ID>
FIREBASE_STORAGE_BUCKET=<YOUR_PROJECT_ID>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=<MESSAGING_SENDER_ID>
FIREBASE_APP_ID=<FIREBASE_APP_ID>

# Add missing environment variable
FIRESTORE_DB_URL=<FIRESTORE_DATABASE_URL>

# Token Configuration
TOKEN_EXPIRY_MINUTES=20
TOKEN_EXPIRY_SECONDS=1200
RETURN_SECURE_TOKEN=true

# Environment
NODE_ENV=development

# SECURITY NOTICE:
# This is an EXAMPLE file with placeholder values only.
# DO NOT commit real credentials to version control.
# 
# To set up your environment:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Obtain credentials from:
#    - Google Cloud Console > IAM & Admin > Service Accounts
#    - Firebase Console > Project Settings > General
# 4. Store production secrets in a secure secrets manager
#    (e.g., Google Secret Manager, AWS Secrets Manager, Azure Key Vault)